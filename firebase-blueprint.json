{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User profile data stored upon sign-in",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "conversions": {
      "title": "Conversion History",
      "description": "User conversion records and logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "toolId": { "type": "string" },
        "toolName": { "type": "string" },
        "outputName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["userId", "fileName", "toolId"]
    },
    "presets": {
      "title": "Favorite Tool Presets",
      "description": "User saved favorite tools or quick conversion presets",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "toolId": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "toolId"]
    }
  }
}
